[sub_resource type="Resource" id="Resource_c7e5e"]
script = ExtResource("11_k63yi")
speaker_name = "Aspen"
text = "This school bus seems eerie..."
metadata/_custom_type_script = "uid://ydeyb2qi3j0f"

[sub_resource type="Resource" id="Resource_ybiqv"]
script = ExtResource("11_k63yi")
speaker_name = "Aspen"
text = "I should check it out with my ghost vision."
metadata/_custom_type_script = "uid://ydeyb2qi3j0f"

[sub_resource type="Resource" id="Resource_lgad6"]
script = ExtResource("11_k63yi")
speaker_name = "Aspen"
text = "Oh no, I didn't expect the bus driver to be  a ghost."
metadata/_custom_type_script = "uid://ydeyb2qi3j0f"

[sub_resource type="Resource" id="Resource_01moj"]
script = ExtResource("11_k63yi")
speaker_name = "Aspen"
text = "To release ghosts I need to match them with their corresponding cursed object."
metadata/_custom_type_script = "uid://ydeyb2qi3j0f"

[sub_resource type="Resource" id="Resource_0qhvc"]
script = ExtResource("11_k63yi")
speaker_name = "Aspen"
text = "As the wielder of ghost vision, i can interact with them, but if I match cursed objects incorrectly the backlash will kill me."
metadata/_custom_type_script = "uid://ydeyb2qi3j0f"

[sub_resource type="Resource" id="Resource_walme"]
script = ExtResource("11_k63yi")
speaker_name = "Aspen"
text = "Im pretty sure this drawing is what's keeping him in the mortal plane, but I'm not sure."
metadata/_custom_type_script = "uid://ydeyb2qi3j0f"

[sub_resource type="Resource" id="Resource_74aqo"]
script = ExtResource("11_k63yi")
speaker_name = "Aspen"
text = "I'll go check with Nash, after all he's the one that drew it."
metadata/_custom_type_script = "uid://ydeyb2qi3j0f"

[sub_resource type="Resource" id="Resource_15xwe"]
script = ExtResource("11_k63yi")
speaker_name = "Aspen"
text = "I don't see him though, hes probably in the back of the bus somewhere."
metadata/_custom_type_script = "uid://ydeyb2qi3j0f"

[sub_resource type="Resource" id="Resource_hh25s"]
script = ExtResource("11_k63yi")
speaker_name = "Aspen"
text = "I'll leave the bus driver alone for now."
metadata/_custom_type_script = "uid://ydeyb2qi3j0f"

