[sub_resource type="Resource" id="Resource_ai15g"]
script = ExtResource("8_ai15g")
speaker_name = "Bus Driver"
text = "My, what a nice drawing, it reminds me of one a student made for me long ago."
metadata/_custom_type_script = "uid://ydeyb2qi3j0f"

[sub_resource type="Resource" id="Resource_4a0gt"]
script = ExtResource("8_ai15g")
speaker_name = "Bus Driver"
text = "Hold on, this is that exact drawing, how did you get this?"
metadata/_custom_type_script = "uid://ydeyb2qi3j0f"

[sub_resource type="Resource" id="Resource_ixdp2"]
script = ExtResource("8_ai15g")
speaker_name = "BusDriver"
text = "You went over to my house and took it? How did you even get in ?"
metadata/_custom_type_script = "uid://ydeyb2qi3j0f"

[sub_resource type="Resource" id="Resource_8tsgb"]
script = ExtResource("8_ai15g")
speaker_name = "Bus Driver"
text = "You asked at my wife? How do you know her ? Your just a student!"
metadata/_custom_type_script = "uid://ydeyb2qi3j0f"

[sub_resource type="Resource" id="Resource_o8oq4"]
script = ExtResource("8_ai15g")
speaker_name = "Bus Driver"
text = "You met her at the funeral?! Who's funeral?"
metadata/_custom_type_script = "uid://ydeyb2qi3j0f"

[sub_resource type="Resource" id="Resource_os4w4"]
script = ExtResource("8_ai15g")
speaker_name = "Bus Driver"
text = "Mine? "
metadata/_custom_type_script = "uid://ydeyb2qi3j0f"

[sub_resource type="Resource" id="Resource_e1p28"]
script = ExtResource("8_ai15g")
speaker_name = "Bus Driver"
text = "But how?"
metadata/_custom_type_script = "uid://ydeyb2qi3j0f"

[sub_resource type="Resource" id="Resource_hvtcx"]
script = ExtResource("8_ai15g")
speaker_name = "Bus Driver"
text = "..."
metadata/_custom_type_script = "uid://ydeyb2qi3j0f"

[sub_resource type="Resource" id="Resource_wlphc"]
script = ExtResource("8_ai15g")
speaker_name = "Bus Driver"
text = "I see ... I'm already dead aren't I."
metadata/_custom_type_script = "uid://ydeyb2qi3j0f"

[sub_resource type="Resource" id="Resource_8noxx"]
script = ExtResource("8_ai15g")
speaker_name = "Bus Driver"
text = "Are you here to release me ?"
metadata/_custom_type_script = "uid://ydeyb2qi3j0f"

[sub_resource type="Resource" id="Resource_aq6ow"]
script = ExtResource("8_ai15g")
speaker_name = "Bus Driver"
text = "Thank you."
metadata/_custom_type_script = "uid://ydeyb2qi3j0f"

